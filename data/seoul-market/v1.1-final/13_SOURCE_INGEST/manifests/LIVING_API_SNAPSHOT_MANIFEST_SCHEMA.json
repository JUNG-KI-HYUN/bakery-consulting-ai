{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frameone://source-ingest/living-api-snapshot-manifest.schema.json",
  "title": "FRAMEONE Seoul 250m Living Population API Snapshot Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifest_kind",
    "schema_version",
    "snapshot_id",
    "source_id",
    "dataset",
    "service_name",
    "source_reference_date",
    "fetched_at",
    "expected_rows",
    "fetched_rows",
    "normalized_rows",
    "quarantine_rows",
    "page_count",
    "unique_cell_count",
    "ymd_distribution",
    "tt_distribution",
    "population_quality",
    "duplicate_candidate_count",
    "schema_validation",
    "checksums",
    "validation",
    "status",
    "staging",
    "current_pointer_updated"
  ],
  "properties": {
    "manifest_kind": { "const": "LIVING_POPULATION_API_SNAPSHOT" },
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "source_id": { "const": "SRC-SEOUL-LIVING" },
    "dataset": { "const": "seoul_living_population_250m" },
    "service_name": { "const": "Se250MSpopLocalResd" },
    "source_reference_date": { "type": ["string", "null"] },
    "fetched_at": { "type": "string", "minLength": 1 },
    "expected_rows": { "type": "integer", "minimum": 0 },
    "fetched_rows": { "type": "integer", "minimum": 0 },
    "normalized_rows": { "type": "integer", "minimum": 0 },
    "quarantine_rows": { "type": "integer", "minimum": 0 },
    "page_count": { "type": "integer", "minimum": 0 },
    "unique_cell_count": { "type": "integer", "minimum": 0 },
    "duplicate_candidate_count": { "type": "integer", "minimum": 0 },
    "status": {
      "enum": ["VALIDATING", "READY", "REVIEW_REQUIRED", "FAILED"]
    },
    "staging": { "type": "boolean" },
    "current_pointer_updated": { "const": false }
  }
}
